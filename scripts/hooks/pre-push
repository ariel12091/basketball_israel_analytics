#!/bin/bash
# Prevents direct pushes to main. Use a branch instead.
# Install: git config core.hooksPath scripts/hooks

branch=$(git symbolic-ref HEAD 2>/dev/null)
if [ "$branch" = "refs/heads/main" ]; then
  echo ""
  echo "  Direct push to main is not allowed."
  echo "  Create a branch: git checkout -b <prefix>/<name>"
  echo "  Prefixes: shiny/ react/ sql/ etl/ infra/"
  echo ""
  exit 1
fi
